# Copy this file to .env.
# Local dev: leave COMPOSE_FILE commented, then npm run dev (Vite serves on PORT + 1, 10923).
# Docker:    uncomment one COMPOSE_FILE line, then docker compose up -d.

# Deployment mode: uncomment exactly ONE line to choose how the service is
# exposed. With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml             # port-published (publishes PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml     # behind a Traefik reverse proxy
# COMPOSE_FILE=compose.cloudflared.yaml # behind a Cloudflare Tunnel (no published port)

# The image every compose file runs. IMAGE_TAG is rewritten by the server's
# global deploy script on each deploy and read back on a rollback — never edit
# it by hand.
IMAGE_NAME=ghcr.io/cheminfo/inorganic.cheminfo.org
IMAGE_TAG=latest

# Host port the site is published on (compose.yaml only). The container itself
# always listens on 80.
#
# rules/backend.md derives the port from the creation date. This project's,
# 2026-09-18, gives 10918, which atoms.cheminfo.org already holds, and
# moles.cheminfo.org holds the next free date's, 10920, so the port is derived
# from 2026-09-22. The Vite dev server takes the next number, 10923, so no two
# cheminfo sites can answer for each other while both are running.
PORT=10922

# The audience-measurement snippet, taken verbatim and injected at the end of
# the <head> of every page the container serves. Unset — as it is here, and as
# it always is under `npm run dev` — means nothing is loaded and nothing is
# counted. Get this site's own website id from https://datami.cheminfo.org.
# TRACKING_SCRIPT=<script defer src="https://datami.cheminfo.org/script.js" data-website-id="00000000-0000-0000-0000-000000000000"></script>

# Cloudflare Tunnel token (compose.cloudflared.yaml only).
# TUNNEL_TOKEN=
